{
  "name": "ventas-online-functions",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "seed": "node scripts/seed.mjs",
    "seed:admin": "node scripts/seed-emulator-admin.mjs",
    "copy:prod": "node scripts/copy-prod-to-emulator.mjs",
    "admin:claim": "node scripts/set-admin-claim.mjs",
    "webhook:test": "node scripts/test-webhook.mjs",
    "logs": "firebase functions:log"
  },
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.4.0",
    "pdfkit": "^0.13.0",
    "resend": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.0",
    "typescript": "^5.6.0"
  },
  "private": true
}
