<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ bloquea el tráfico HTTP sin cifrar. Los emuladores de Firebase
  hablan HTTP plano, así que se permite SOLO para las direcciones locales de
  prueba (127.0.0.1 por `adb reverse`, localhost y 10.0.2.2 del emulador de
  Android). Cualquier dominio real sigue exigiendo HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
